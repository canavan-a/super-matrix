# Super Matrix relay configuration (/etc/supermatrix/relay.env).
# The relay token goes in /etc/supermatrix/relay-token, not here.

# The server's admin URL.
SUPERMATRIX_SERVER_URL=https://matrix.example.com

# auto: QUIC when UDP gets through, otherwise the WebSocket (and back to
# QUIC once it works again). Or pin one: quic | websocket.
SUPERMATRIX_TRANSPORT=auto
# Overrides the QUIC host:port the server advertises.
#SUPERMATRIX_QUIC_ADDR=

# The local API for managing this relay's deployments from this machine
# (supermatrix-relay list/create/update/delete), once "Manage its
# deployments" is on for the relay in the app. No auth: anything that can
# run programs here can use it. Loopback addresses only, or "off".
#SUPERMATRIX_LOCAL_ADDR=127.0.0.1:3388
