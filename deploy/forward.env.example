# A Super Matrix forward (/etc/supermatrix/forward-NAME.env).
# The deployment's API token goes in /etc/supermatrix/forward-NAME-token.

# The SSH deployment's URL.
SUPERMATRIX_URL=https://ssh-box.example.com
# Where the local port listens; then e.g. ssh -p 2222 you@127.0.0.1
SUPERMATRIX_LISTEN=127.0.0.1:2222
