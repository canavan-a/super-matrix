# Super Matrix server configuration (/etc/supermatrix/server.env).
# The root password goes in /etc/supermatrix/root-password, not here.

# Admin API, web app, and where relays connect. Point DNS at this machine.
SUPERMATRIX_ADMIN_HOST=matrix.example.com
# Optional: on a server with no domains yet, *.<this> becomes the first one.
# Add more (wildcard *.example.com or exact status.foo.org) in the app. Point
# each at this machine; every deployment gets its own certificate.
SUPERMATRIX_BASE_DOMAIN=example.com

# "acme": Let's Encrypt certificate per host. "off": plain HTTP on
# SUPERMATRIX_HTTP_ADDR only (behind another TLS proxy).
SUPERMATRIX_TLS=acme
SUPERMATRIX_HTTP_ADDR=:80
SUPERMATRIX_HTTPS_ADDR=:443
# Optional contact for Let's Encrypt expiry notices.
SUPERMATRIX_ACME_EMAIL=
# Set to "staging" while testing to avoid Let's Encrypt rate limits.
#SUPERMATRIX_ACME_DIRECTORY=staging

SUPERMATRIX_DATA_DIR=/var/lib/supermatrix
# Serve the web app on the admin host (npm run build:web output).
SUPERMATRIX_STATIC_DIR=/usr/local/share/supermatrix/web
# Only with TLS off behind a proxy on this machine.
SUPERMATRIX_TRUST_PROXY=0

# Relays connect over QUIC (UDP) when they can, and fall back to the
# WebSocket on 443/TCP when UDP is blocked. Open this UDP port too.
SUPERMATRIX_QUIC=on
# UDP listener; defaults to the HTTPS port (the HTTP one with TLS off).
#SUPERMATRIX_QUIC_ADDR=:443
# host:port relays dial, if a NAT/firewall maps a different port.
#SUPERMATRIX_QUIC_PUBLIC=matrix.example.com:443
